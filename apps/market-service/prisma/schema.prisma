generator client {
  provider      = "prisma-client-js"
  output        = "../../../node_modules/.prisma/market-client"
  binaryTargets = ["native", "linux-musl-openssl-3.0.x"]
}

datasource db {
  provider = "postgresql"
  url      = env("MARKET_DATABASE_URL")
}

model Market {
  id              String         @id @default(cuid())
  slug            String         @unique
  title           String
  description     String         @db.Text
  longDescription String?        @db.Text
  category        String
  tags            String[]
  imageUrl        String?
  sourceUrl       String?

  status          MarketStatus   @default(DRAFT)
  resolution      ResolutionType @default(MANUAL)

  openAt          DateTime
  closeAt         DateTime
  resolveAt       DateTime?
  resolvedAt      DateTime?
  createdAt       DateTime       @default(now())
  updatedAt       DateTime       @updatedAt

  resolvedOutcome Outcome?
  resolutionNote  String?
  resolvedBy      String?

  poolYesKes  Decimal @default(0) @db.Decimal(15, 2)
  poolNoKes   Decimal @default(0) @db.Decimal(15, 2)
  totalVolume Decimal @default(0) @db.Decimal(15, 2)
  tradeCount  Int     @default(0)
  rake        Decimal @default(0.04) @db.Decimal(4, 3)

  seedYesKes Decimal @default(1000) @db.Decimal(15, 2)
  seedNoKes  Decimal @default(1000) @db.Decimal(15, 2)

  createdBy String

  // BINARY markets keep the YES/NO columns above and their existing code path
  // untouched. MULTI markets ("who wins the Ballon d'Or?") carry their runners
  // in MarketOption instead, each with its own pool.
  marketType MarketType @default(BINARY)

  outcomes      MarketOutcome[]
  options       MarketOption[]
  feedConfig    FeedConfig?
  priceHistory  PriceSnapshot[]
  optionPriceHistory OptionPriceSnapshot[]

  @@index([status, category])
  @@index([closeAt])
  @@index([slug])
  @@map("markets")
}

/// One runner in a MULTI market — a candidate, fighter or team. `poolKes` is
/// this option's share of the parimutuel pot; price is poolKes / total across
/// the market's options, the same formula the binary path uses.
model MarketOption {
  id        String  @id @default(cuid())
  marketId  String
  label     String
  imageUrl  String?
  sortOrder Int     @default(0)

  poolKes    Decimal @default(0) @db.Decimal(15, 2)
  seedKes    Decimal @default(1000) @db.Decimal(15, 2)
  totalShares Decimal @default(0) @db.Decimal(18, 6)

  isWinner Boolean @default(false)

  market Market @relation(fields: [marketId], references: [id], onDelete: Cascade)

  @@unique([marketId, label])
  @@index([marketId])
  @@map("market_options")
}

model MarketOutcome {
  id       String  @id @default(cuid())
  marketId String
  label    Outcome

  market Market @relation(fields: [marketId], references: [id], onDelete: Cascade)

  @@unique([marketId, label])
  @@map("market_outcomes")
}

model PriceSnapshot {
  id         String   @id @default(cuid())
  marketId   String
  yesPrice   Decimal  @db.Decimal(6, 4)
  noPrice    Decimal  @db.Decimal(6, 4)
  volume     Decimal  @db.Decimal(15, 2)
  snapshotAt DateTime @default(now())

  market Market @relation(fields: [marketId], references: [id], onDelete: Cascade)

  @@index([marketId, snapshotAt])
  @@map("price_snapshots")
}

/// One option's price at one point in time, for MULTI markets — the
/// pick-a-winner equivalent of PriceSnapshot. One row per option per trade,
/// not one row per market, since each option's price moves independently.
model OptionPriceSnapshot {
  id         String   @id @default(cuid())
  marketId   String
  optionId   String
  price      Decimal  @db.Decimal(6, 4)
  poolKes    Decimal  @db.Decimal(15, 2)
  snapshotAt DateTime @default(now())

  market Market @relation(fields: [marketId], references: [id], onDelete: Cascade)

  @@index([marketId, snapshotAt])
  @@index([optionId, snapshotAt])
  @@map("option_price_snapshots")
}

model FeedConfig {
  id          String    @id @default(cuid())
  marketId    String    @unique
  feedType    FeedType
  feedSource  String
  feedQuery   Json
  lastChecked DateTime?
  lastResult  Json?

  market Market @relation(fields: [marketId], references: [id], onDelete: Cascade)

  @@map("feed_configs")
}

enum MarketStatus {
  DRAFT
  ACTIVE
  CLOSED
  RESOLVED
  CANCELLED
  DISPUTED
}

enum MarketType {
  /// YES/NO — the original path; pools live on Market.poolYesKes/poolNoKes.
  BINARY
  /// Pick-a-winner among N runners; pools live on MarketOption.
  MULTI
}

enum Outcome {
  YES
  NO
}

enum ResolutionType {
  MANUAL
  AUTOMATED_FEED
  ORACLE
}

enum FeedType {
  SPORTS_API
  NEWS_SCRAPER
  MANUAL_ORACLE
  CRYPTO_PRICE
  WEATHER_API
}
